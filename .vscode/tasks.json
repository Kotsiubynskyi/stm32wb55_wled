{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: clean",
            "command": "clean",
            "problemMatcher": [],
            "detail": "CMake template clean task"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build build",
            "group": "build",
            "detail": "Builds the firmware using CMake."
        },
        {
            "label": "Upload",
            "type": "shell",
            "command": "st-flash --reset write build/stm32wb55_wled.bin 0x08000000",
            "group": "none",
            "dependsOn": "Build",
            "detail": "Flashes the firmware using the st-flash tool, then resets the device."
        },
        {
            "label": "Build and Upload",
            "dependsOn": [
                "Build",
                "Upload"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Sequentially builds the project and then flashes it to the target."
        },
        {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": [
                "all"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake template build task"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: arm-none-eabi-gcc build active file",
            "command": "/bin/arm-none-eabi-gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}